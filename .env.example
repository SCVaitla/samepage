# Copy to .env and fill in. Never commit .env.

# --- Switch (agent bridge) ---
# The bridge base URL, NOT the Gateway URL. `GET $SWITCH_API_URL/health` must return 200.
SWITCH_API_URL=http://127.0.0.1:8000
# Personal registration key minted by YOU (Gateway -> API keys), so the Arbiter
# has the same owner as the worker agents. Do not use the deployment bootstrap
# key: it resolves to a separate owner and breaks owner-agents addressing.
SWITCH_REGISTRATION_TOKEN=
# Filled in by `spike/arbiter_spike.py register` (returned once by Switch).
SWITCH_AGENT_ID=
SWITCH_AGENT_API_KEY=
SWITCH_AGENT_NAME=samepage-arbiter

# --- GitHub (fine-grained token, ONE demo repo, contents + pull requests only) ---
GITHUB_TOKEN=
GITHUB_DEMO_REPO=owner/juniper-desk-docs

# --- LLM (claim extraction only; temperature 0, cached) ---
ANTHROPIC_API_KEY=
