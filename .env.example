# Copy to .env (`make setup` does it) and fill in. Never commit .env.

# --- Switch: the arbiter is an agent on your Switch server -----------------------
# The bridge URL (NOT the Gateway URL). `curl $SWITCH_API_URL/health` must return 200.
SWITCH_API_URL=http://127.0.0.1:8000
# YOUR personal registration key (Gateway -> API keys). Not the bootstrap key: that
# gives the arbiter a different owner, and the workers would ignore it.
SWITCH_REGISTRATION_TOKEN=
SWITCH_AGENT_NAME=samepage-arbiter
# Written by `uv run samepage register` (the key is shown only once):
# SWITCH_AGENT_ID=
# SWITCH_AGENT_API_KEY=

# --- Rooms: ids from `uv run samepage rooms` after creating them from the template --
SAMEPAGE_ASK_ROOM=
SAMEPAGE_DESKS=samepage-claude=<desk-claude-room-id>,samepage-codex=<desk-codex-room-id>
SAMEPAGE_FIX_ROOM=
SAMEPAGE_FIXER=samepage-fixer
# Who may rule on any case (comma-separated messaging usernames). Owners of the losing
# docs (corpus/sources.yaml) may always rule on their own cases.
SAMEPAGE_APPROVERS=

# --- Docs: your local clone of the demo docs repo (the engine reads origin/<ref>) --
SAMEPAGE_DOCS_REPO_DIR=
SAMEPAGE_DOCS_SUBDIR=

# --- GitHub: fine-grained token, ONE repo, Contents: read + Pull requests: read ------
GITHUB_TOKEN=
GITHUB_DEMO_REPO=you/juniper-desk-docs

# --- Tuning (defaults are fine) --------------------------------------------------------
SAMEPAGE_AGENT_TIMEOUT=240
SAMEPAGE_BATCH_SIZE=6
SAMEPAGE_RETEST_QUESTIONS=4
SAMEPAGE_EQUIVALENCE_THRESHOLD=0.35
SAMEPAGE_QUOTE_SLACK_LINES=2
SAMEPAGE_DB_PATH=samepage.sqlite
